# iSpace 配置样例
#
# 复制为 .env 后按需填写。.env 已在 .gitignore 里，不会被提交。
#
# 三类变量分开放：
#   [部署机]   跑 infra/scripts/*.sh 时读，留在你的开发机上
#   [服务端]   deploy-service / updates-service 的运行时配置
#   [壳]       构建手机壳时读，会被**编译进二进制**
#
# 服务端的密钥不从这个文件走——它们在目标机的 ~/.ispace/*.env 里（600），
# 由部署脚本注入 compose。理由：这个文件在开发机上，而密钥不该离开服务器。


# ─────────────────────────────────────────────────────────────────────
# 必填
# ─────────────────────────────────────────────────────────────────────

# [部署机+服务端] 平台对外的根地址，带协议、不带尾斜杠。
# 所有绝对链接（密码重置、二维码、更新 manifest）都由它拼出来。
ISPACE_BASE_URL=https://ispace.example.com

# [服务端] 同上，服务端进程读的是这个名字。保持与 ISPACE_BASE_URL 一致。
#
# ⚠️ 它的 **scheme 必须与手机壳构建时的 EXPO_PUBLIC_ISPACE_BASE_URL 一致**。
# 这里写 http 而壳是 https 时，壳的 usesCleartextTraffic 是 false，安卓会在
# 平台层静默掐掉更新包的下载——JS 侧不抛异常也不超时，用户看到的是「正在
# 下载」一直转。见 apps/mobile-shell/CLEARTEXT.md。
ISPACE_PUBLIC_BASE=https://ispace.example.com

# [部署机] 裸域名，不带协议——Traefik 的 Host() 规则用它。
ISPACE_DOMAIN=ispace.example.com

# [部署机] 部署目标机，ssh 的目标。脚本一律经 infra/scripts/remote.sh 连它。
TARGET_HOST=deploy@ispace.example.com

# [部署机] 管理员邮箱。GoTrue 的发件人，同时用作 certbot 注册邮箱。
ISPACE_ADMIN_EMAIL=admin@example.com


# ─────────────────────────────────────────────────────────────────────
# 账号准入 —— 公网部署务必确认这一项
# ─────────────────────────────────────────────────────────────────────

# [服务端] 允许自助注册的邮箱后缀，逗号分隔。
#
# ⚠️ 注册一次就发一个数据 schema 和一份配额。留空表示**不限后缀**，
# 公网实例上等于对全互联网开放注册。不配的默认值是 example.com——
# 谁都匹配不上，也就谁都注册不了。宁可失败在这一边。
#
# 只作为首次初始化的种子；之后以库里的 platform_policy 为准
# （管理员在控制台「平台设置」里改），否则界面上改完重启就被打回原样。
ISPACE_EMAIL_DOMAINS=example.com


# ─────────────────────────────────────────────────────────────────────
# 网关与 TLS
# ─────────────────────────────────────────────────────────────────────

# [部署机] Traefik 入口。三种部署形态对应三种配法：
#
#   A. 公网、Traefik 自己签证书  → websecure，ISPACE_TLS_LABEL 不设
#   B. 内网、根本没有 TLS        → web，ISPACE_TLS_LABEL 设成下面那行
#   C. 上游网关终结 TLS 后转明文 → web，ISPACE_TLS_LABEL 设成下面那行
#      （对外仍是 https，ISPACE_PUBLIC_BASE 要写 https://）
ISPACE_TRAEFIK_ENTRYPOINT=websecure

# [部署机] TLS 标签开关。
#
# ⚠️ 这是最容易踩且最难认的一个坑：Traefik 的 router 只要带上
# tls.certresolver 标签，就**只匹配 HTTPS**。挂在 web 入口上却留着它，
# 结果是路由存在、后端健康、`traefik/api/http/services` 显示 UP，
# 而所有请求 503——没有任何一个 router 接得住。
#
# 所以整条标签做成了变量。形态 B/C 请解除下面这行注释：值是一条重复声明
# 的既有标签，等效于「这里什么都不加」。
# ISPACE_TLS_LABEL=traefik.enable=true

# [部署机] 证书签发器。Dokploy 自带 letsencrypt。仅形态 A 有意义。
ISPACE_CERT_RESOLVER=letsencrypt

# [部署机] 容器内进程的 uid:gid，必须与 /srv 下目录的属主一致，否则写不进去。
# 默认 1000 对应多数发行版的第一个普通用户。
ISPACE_UID=1000
ISPACE_GID=1000

# [部署机] /srv 目录的属主。不设则取 TARGET_HOST 里 @ 前面那段。
# ISPACE_DEPLOY_USER=deploy

# [部署机] SSH 私钥。仓库外，600。
# 生成：ssh-keygen -t ed25519 -f ~/.ssh/ispace_deploy -N '' -C ispace-deploy
DEPLOY_KEY=~/.ssh/ispace_deploy


# ─────────────────────────────────────────────────────────────────────
# 手机壳（构建期，会编译进二进制）
# ─────────────────────────────────────────────────────────────────────

# [壳] 壳要连的实例。EXPO_PUBLIC_ 前缀是 Expo 的约定，打包时内联成字面量。
#
# 它同时决定两个原生开关：地址是 http:// 时自动放行明文流量
# （Android usesCleartextTraffic / iOS NSAllowsArbitraryLoads），
# https:// 时关闭。详见 apps/mobile-shell/CLEARTEXT.md。
#
# 改它必须重新出壳——原生配置，改 JS 不生效。
EXPO_PUBLIC_ISPACE_BASE_URL=https://ispace.example.com

# [壳] 应用标识，换成你自己的反向域名。
# ⚠️ 它是更新与覆盖安装的身份：发出去之后再改，既有安装收不到更新，只能重装。
ISPACE_APP_ID=com.example.ispace


# ─────────────────────────────────────────────────────────────────────
# 可选：编排器
# ─────────────────────────────────────────────────────────────────────

# [服务端] 缺这两项则回落 MockOrchestrator（本地开发无需配置，
# 但控制台的「后端应用」屏就没有真实数据）。
# DOKPLOY_URL=http://127.0.0.1:3000
# DOKPLOY_TOKEN=
# DOKPLOY_PROJECT=ispace


# ─────────────────────────────────────────────────────────────────────
# 可选：Coding Agent 与语音
# ─────────────────────────────────────────────────────────────────────

# [服务端] 任何兼容 OpenAI chat completions 的网关。
# 缺失时 Agent 端点返回「未配置」，其余功能不受影响。
#
# ⚠️ 别用 codex 专用模型：实测其工具调用 arguments 恒为空字符串，
# 走的不是标准 chat completions 协议，驱动不了 Agent。详见
# packages/agent/src/engine.ts 顶部。
# AGENT_BASE_URL=
# AGENT_API_KEY=
# AGENT_MODEL=gpt-5.6
# AGENT_TIMEOUT_MS=120000
# AGENT_MAX_TOKENS=

# [服务端] 语音转写。缺失时 /voice/transcribe 返回 NOT_IMPLEMENTED，
# 手机端据此保持置灰，不静默失败。
# STEP_API_KEY=
# STEP_ASR_URL=
# STEP_ASR_MODEL=


# ─────────────────────────────────────────────────────────────────────
# 可选：SSO（不接也能用，平台默认邮箱 + 密码登录）
# ─────────────────────────────────────────────────────────────────────

# [服务端] 配齐三项即启用 OIDC。回调地址要在 IdP 白名单里登记为
# $ISPACE_PUBLIC_BASE/deploy/api/auth/callback（逐字符一致，含协议）。
# 详见 docs/runbooks/sso-setup.md。
# OIDC_ISSUER=https://sso.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE=openid profile email

# [服务端] 开发登录页（/deploy/api/auth/mock），可选任意身份进入。
# ⚠️ 安全性等于零，生产环境绝对不要设。不设则该路径一律 404。
# ISPACE_DEV_LOGIN=1


# ─────────────────────────────────────────────────────────────────────
# 可选：路径与数据库（有默认值，一般不用改）
# ─────────────────────────────────────────────────────────────────────

# ISPACE_SITES_ROOT=/srv/sites
# ISPACE_RELEASES_ROOT=/srv/releases
# ISPACE_BUNDLE_ROOT=/srv/bundles
# ISPACE_WORKSPACE_ROOT=/srv/workspaces
# ISPACE_SCHEMA=ispace

# 发布链路的密钥扫描。装了 gitleaks 就会用；ISPACE_GITLEAKS=0 可关掉
# （不建议——它是阻断硬编码密钥进产物的那道闸）。
# ISPACE_GITLEAKS=1
# ISPACE_GITLEAKS_BIN=gitleaks

# PGHOST=supabase-db
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPOOL_MAX=10
